# ── Database ──────────────────────────────────────────────────────────────────
# In Docker, DB_HOST must match the service name in docker-compose.yml
DB_HOST=db
DB_PORT=5432
DB_NAME=ksg_reports
DB_USER=ksg_user
DB_PASS=change_this_to_a_strong_password

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=http://45.55.229.189

# ── Email ─────────────────────────────────────────────────────────────────────
# Set MAIL_ENABLED=true and fill in credentials to activate email notifications
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=noreply@ksg.ac.ke
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM_ADDRESS=noreply@ksg.ac.ke
MAIL_FROM_NAME="KSG Reports System"
